# AIGH Nursing Workforce Management System — Scheduled Nightly Backup
# Edit with: crontab -u postgres -e
#
# Runs daily at 01:00 Asia/Riyadh = 22:00 UTC (spec §10.6, owner decision D-40).
# Cron uses the HOST clock. Pick the one line that matches the host time zone:
#   host on UTC (recommended for servers):
0 22 * * * /bin/bash /opt/nurse_appV04/ops/backup/scripts/nightly-backup.sh >> /var/log/aigh-backup.log 2>&1
#   host on Asia/Riyadh:
# 0 1 * * * /bin/bash /opt/nurse_appV04/ops/backup/scripts/nightly-backup.sh >> /var/log/aigh-backup.log 2>&1
# Check the host with: timedatectl | grep "Time zone"
