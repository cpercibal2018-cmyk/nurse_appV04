# AIGH Nursing Workforce V04 — backend environment. Copy to backend/.env.
# Every variable is validated at startup (backend/src/config/env.ts).

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Matches docker-compose.yml (development only). On a PostgreSQL server that also
# hosts V03, do NOT use "nurseapp": that is V03's database. Use a separate one, e.g.
# nurseapp_v04, owned by the V04 login (V04 must never touch the legacy data).
DATABASE_URL=postgresql://aigh:aigh_dev_only@localhost:5432/nurseapp
# Separate, migrated database for integration tests. Tests add uniquely named rows
# and leave them (the audit trail is append-only), so the database grows; drop and
# re-create it (then db:deploy) whenever convenient. Never point it at real data.
TEST_DATABASE_URL=postgresql://aigh:aigh_dev_only@localhost:5432/nurseapp_test

# ── Authentication (spec §3.3, §3.4; decision D-6) ────────────────────────────
# Signing key for access tokens: at least 32 characters of random data.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900        # 15 min (spec §3.4)
SESSION_IDLE_SECONDS=3600           # 1 h without refresh ends the session (spec §3.3)
SESSION_ABSOLUTE_SECONDS=86400      # 24 h absolute boundary (spec §3.3/§3.4)
BCRYPT_ROUNDS=12                    # spec §3.4
# Login attempt limits — spec §3.3 requires them but sets no numbers
# (REQUIREMENT NOT ESTABLISHED). Implementation defaults; confirm with hospital IT.
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_MAX_PER_ACCOUNT=5
LOGIN_THROTTLE_MAX_PER_CLIENT=20
# ── Uploads (spec §5.1.5, §5.3.2; decision D-10) ────────────────────────────
STORAGE_DIR=./storage
UPLOAD_MAX_SIZE_BYTES=10485760
# dev-magic-bytes: files are marked CLEAN after size and magic-byte checks
# (development only). Production refuses to start without a real scanner, and
# the ClamAV adapter is not built yet.
UPLOAD_SCANNER=dev-magic-bytes

# true only behind the reverse proxy (so the client IP is the real client).
TRUST_PROXY=false

# Background jobs: in-process (development — the API runs them), worker
# (production — run `npm run worker` separately and set this on the API), off.
JOBS_MODE=in-process

# ── Demo fixtures (development only: npm run fixtures:demo -w backend) ────────
# There is no seed. Hospital data enters through `npm run bootstrap` and the
# baseline import (docs/DATABASE_ARCHITECTURE.md §7). The demo fixtures load
# demo logins (admin@, hr.admin@, supervisor@, nurse@, breakglass@aigh.sa) and
# fictional staff into an EMPTY database named *_dev / *_test / *_demo only.
# 12–72 characters (spec §3.2). Never set in production.
DEMO_PASSWORD=

# ── Data residency (spec §8.3, fail-closed) ───────────────────────────────────
# KSA regions only. NEVER list AWS me-south-1 (Bahrain) or me-central-1 (UAE).
# Examples: me-jeddah-1, me-riyadh-1 (Oracle), me-central-2 (Google Dammam),
# ksa-onprem (hospital data centre). "local" is accepted outside production only.
DATA_RESIDENCY_REGION=local
PDPL_ALLOWED_REGIONS=local
